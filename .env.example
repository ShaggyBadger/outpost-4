# Local development settings. scripts/init.sh creates .env and configures the site name/key.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
WAGTAIL_SITE_NAME=New Website
WAGTAILADMIN_BASE_URL=http://localhost:8000
PUBLIC_SITE_URL=http://localhost:8000
# Optional: configure both the recipient and mail transport to email custom-order requests.
CUSTOM_ORDER_NOTIFICATION_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# Django connects to the Postgres service by its Compose service name.
DATABASE_HOST=db
DATABASE_PORT=5432
POSTGRES_DB=website
POSTGRES_USER=website
POSTGRES_PASSWORD=local-development-only-change-me

# Optional Linode Object Storage for media. Keep one unique location per site
# when sharing a development bucket. Credentials are only required when enabled.
USE_LINODE_OBJECT_STORAGE=False
LINODE_STORAGE_ENDPOINT=
LINODE_STORAGE_REGION=
LINODE_STORAGE_BUCKET_NAME=
LINODE_STORAGE_LOCATION=new-site/media
LINODE_STORAGE_DEFAULT_ACL=public-read
LINODE_ACCESS_KEY_ID=
LINODE_SECRET_ACCESS_KEY=
