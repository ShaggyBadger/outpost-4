{
  "name": "django-wagtail-site-assets",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./static-src/css/input.css -o ./static/css/site.css --minify",
    "watch:css": "tailwindcss -i ./static-src/css/input.css -o ./static/css/site.css --watch=always"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  },
  "overrides": {
    "@parcel/watcher": "2.6.0"
  }
}
